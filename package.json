{
  "name": "next-typed-paths",
  "version": "1.0.0",
  "description": "A realtime typesafe Next.Js route generation tool",
  "keywords": [
    "nextjs",
    "routes",
    "typescript",
    "type-safe",
    "app-router"
  ],
  "homepage": "https://github.com/hugs7/next-typed-paths#readme",
  "bugs": {
    "url": "https://github.com/hugs7/next-typed-paths/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugs7/next-typed-paths.git"
  },
  "license": "MIT",
  "author": "Hugo Burton",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "next-typed-paths": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.cjs",
      "default": "./dist/runtime/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.cjs",
      "default": "./dist/contracts/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs",
      "default": "./dist/client/index.js"
    },
    "./axios": {
      "types": "./dist/axios/index.d.ts",
      "import": "./dist/axios/index.js",
      "require": "./dist/axios/index.cjs",
      "default": "./dist/axios/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs",
      "default": "./dist/next/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "tsc": "tsc -p tsconfig.lib.json",
    "build": "pnpm tsc && vite build",
    "prepublishOnly": "pnpm build",
    "test": "npx tsc -p tsconfig.spec.json --noEmit && vitest",
    "test:e2e": "pnpm --silent build && node dist/cli.js generate --config ./test/routes.config.ts",
    "test:e2e:watch": "pnpm test:e2e -- --watch"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "cosmiconfig": "^10.0.1",
    "lodash-es": "^4.18.1",
    "prettier": "^3.9.8",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.2",
    "axios": "^1.20.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "axios": ">=1.0.0 <2.0.0",
    "typescript": ">=5.0.0",
    "zod": ">=4.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  }
}
